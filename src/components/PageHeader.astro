---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="border-b border-border/80 bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-xs tracking-[0.3em] text-accent">{eyebrow}</p>
    <h1 class="mt-3 text-3xl font-semibold text-foreground sm:text-4xl">
      {title}
    </h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
          {description}
        </p>
      )
    }
  </div>
</div>
