---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Reveal from "@/components/Reveal.astro";

const jazzClubs = [
  { name: "電通大ジャズ研", url: "https://x.com/uecjazz" },
  { name: "東京外国語大学モダンジャズ研究所", url: "https://x.com/tufs_jazz_lab" },
  { name: "東京学芸大学軽音楽部JAZZ研", url: "https://x.com/Key_Cocko" },
  { name: "東京大学ジャズ研究会", url: "https://x.com/utokyojazz" },
  { name: "一橋大学モダンジャズ研究会", url: "https://x.com/hit_jazz" },
];

const liveHouses = [
  { name: "GINZ - Jazz & Soul Live -", url: "http://www.sam.hi-ho.ne.jp/ginz/" },
  { name: "Tea&Jazz Bar 停車場", url: "https://www.teishabajazz.com/" },
];
---

<BaseLayout
  title="Link"
  description="他大学のジャズ研究会や、日頃お世話になっているライブ・セッションハウスへのリンク集。"
>
  <PageHeader
    eyebrow="LINK"
    title="リンク"
    description="日頃交流のある他大学のジャズ研究会や、お世話になっているライブ・セッションハウスをご紹介します。"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <Reveal>
      <h2 class="text-2xl font-semibold text-foreground sm:text-3xl">
        他大学ジャズ研
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        合同セッションなどで交流のあるジャズ研究会です。ジャズ研といえばTwitterなので(偏見)、Twitterアカウントを掲載しておきます。
      </p>
      <ul class="mt-8 divide-y divide-border/80 border-y border-border/80">
        {
          jazzClubs.map((item) => (
            <li>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-4 py-4 text-sm text-foreground transition-colors hover:text-accent sm:text-base"
              >
                <span>{item.name}</span>
                <span aria-hidden="true" class="text-muted">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </section>

  <section class="border-t border-border/80 bg-surface">
    <Reveal class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-2xl font-semibold text-foreground sm:text-3xl">
        ライブ・セッションハウス
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        定期演奏会などでお世話になっています。
      </p>
      <ul class="mt-8 divide-y divide-border/80 border-y border-border/80">
        {
          liveHouses.map((item) => (
            <li>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-4 py-4 text-sm text-foreground transition-colors hover:text-accent sm:text-base"
              >
                <span>{item.name}</span>
                <span aria-hidden="true" class="text-muted">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </section>
</BaseLayout>
