---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Reveal from "@/components/Reveal.astro";
import { siteConfig } from "@/lib/site";
---

<BaseLayout
  title="Contact"
  description="見学・入部のお問い合わせはSNSからお気軽にどうぞ。"
>
  <PageHeader
    eyebrow="CONTACT"
    title="連絡先"
    description="見学・入部のご相談、練習日程のお問い合わせなどは、公式LINE・SNSのDMからお気軽にご連絡ください。"
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-8 sm:grid-cols-2">
      <Reveal delay={0}>
        <a
          href={siteConfig.twitterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full flex-col items-start gap-3 rounded-lg border border-border/80 bg-surface p-8 transition-colors hover:border-accent"
        >
          <span class="text-xl font-semibold text-foreground">X (Twitter)</span>
          <span class="text-sm text-muted">{siteConfig.twitterHandle}</span>
        </a>
      </Reveal>
      <Reveal delay={100}>
        <a
          href={siteConfig.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full flex-col items-start gap-3 rounded-lg border border-border/80 bg-surface p-8 transition-colors hover:border-accent"
        >
          <span class="text-xl font-semibold text-foreground">Instagram</span>
          <span class="text-sm text-muted">{siteConfig.instagramHandle}</span>
        </a>
      </Reveal>
      <Reveal delay={100}>
        <a
          href={siteConfig.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full flex-col items-start gap-3 rounded-lg border border-border/80 bg-surface p-8 transition-colors hover:border-accent"
        >
          <span class="text-xl font-semibold text-foreground">LINE</span>
          <span class="text-sm text-muted">{siteConfig.lineHandle}</span>
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>
